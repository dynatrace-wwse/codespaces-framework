[Unit]
Description=Orbital restore drill (verifies the latest DR snapshot is restorable)

[Service]
Type=oneshot
User=root
# --s3: drill the OFFSITE copy. A local drill only proves the snapshot on the
# master is readable, and the master is the host whose loss the backups exist
# for. Only the offsite path is evidence of disaster recovery.
ExecStart=/home/ops/enablement-framework/codespaces-framework/ops-server/tools/backup/orbital-restore-drill.sh --s3
EnvironmentFile=-/etc/default/orbital-backup
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal
SyslogIdentifier=orbital-restore-drill

[Install]
WantedBy=multi-user.target
