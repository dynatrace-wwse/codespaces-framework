[Unit]
Description=Orbital DR snapshot (Redis + env + service config)
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
# Runs from the Orbital checkout so a `git pull` updates the script in place.
ExecStart=/home/ops/enablement-framework/codespaces-framework/ops-server/tools/backup/orbital-backup.sh
# Offsite is opt-in: set ORBITAL_BACKUP_S3_URI (and optionally
# ORBITAL_BACKUP_S3_KMS_KEY) in this file once the bucket exists. Until then
# the run is local-only and still succeeds.
EnvironmentFile=-/etc/default/orbital-backup
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal
SyslogIdentifier=orbital-backup

[Install]
WantedBy=multi-user.target
